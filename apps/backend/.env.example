# Copy to .env.development (local) and .env.production (prod).
# The file is chosen by NODE_ENV: .env.${NODE_ENV}, falling back to .env.

PORT=3000

# Origin of the frontend app. Used for CORS and for redirecting back after Google login.
FRONTEND_URL=http://localhost:5173

# Google OAuth — the redirect URI must also be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

GEMINI_API_KEY=

# Neon Postgres: pooled URL for the app, direct (no "-pooler") URL for migrations.
DATABASE_URL=
DIRECT_URL=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional: Gemini models to try in order (comma-separated).
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
